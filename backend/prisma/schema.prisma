generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CardType {
  CREATURE
  SPELL
}

enum Rarity {
  COMUN
  RARA
  EPICA
  LEGENDARIA
}

enum MatchStatus {
  WAITING
  IN_PROGRESS
  FINISHED
  ABANDONED
}

enum Role {
  USER
  ADMIN
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  username     String   @unique
  passwordHash String
  displayName  String?
  avatarUrl    String?
  coverUrl     String?
  bio          String?
  role         Role     @default(USER)
  banned       Boolean  @default(false)
  banReason    String?
  rating       Int      @default(1000)
  peakRating   Int      @default(1000)
  createdAt    DateTime @default(now())

  decks         Deck[]
  posts         Post[]
  comments      Comment[]
  likes         Like[]
  stories       Story[]

  following     Follow[] @relation("Following")
  followers     Follow[] @relation("Followers")

  matchesAsP1   Match[]  @relation("Player1")
  matchesAsP2   Match[]  @relation("Player2")
  matchesWon    Match[]  @relation("Winner")

  notifications Notification[] @relation("NotificationTarget")

  conversationsA Conversation[] @relation("ParticipantA")
  conversationsB Conversation[] @relation("ParticipantB")
  messagesSent   Message[]      @relation("MessageSender")

  achievements   UserAchievement[]
  groupsOwned    Group[]           @relation("GroupOwner")
  groupMemberships GroupMember[]
}

model Follow {
  id          String   @id @default(cuid())
  follower    User     @relation("Following", fields: [followerId], references: [id])
  followerId  String
  following   User     @relation("Followers", fields: [followingId], references: [id])
  followingId String
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
}

model Card {
  id          String   @id @default(cuid())
  name        String   @unique
  cost        Int
  type        CardType
  attack      Int?
  health      Int?
  rarity      Rarity
  effectKey   String?
  description String
  imageUrl    String?
  set         String?

  deckCards   DeckCard[]

  @@index([set])
}

model Deck {
  id        String     @id @default(cuid())
  name      String
  owner     User       @relation(fields: [ownerId], references: [id])
  ownerId   String
  isPublic  Boolean    @default(false)
  featured  Boolean    @default(false)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  cards     DeckCard[]
}

model DeckCard {
  id       String @id @default(cuid())
  deck     Deck   @relation(fields: [deckId], references: [id], onDelete: Cascade)
  deckId   String
  card     Card   @relation(fields: [cardId], references: [id])
  cardId   String
  quantity Int    @default(1)

  @@unique([deckId, cardId])
}

model Match {
  id         String      @id @default(cuid())
  player1    User        @relation("Player1", fields: [player1Id], references: [id])
  player1Id  String
  player2    User        @relation("Player2", fields: [player2Id], references: [id])
  player2Id  String
  winner     User?       @relation("Winner", fields: [winnerId], references: [id])
  winnerId   String?
  status     MatchStatus @default(WAITING)
  createdAt  DateTime    @default(now())
  finishedAt DateTime?
}

model Post {
  id        String    @id @default(cuid())
  author    User      @relation(fields: [authorId], references: [id])
  authorId  String
  content   String
  imageUrl  String?
  images    String[]  @default([])
  matchId   String?
  deckId    String?
  group     Group?    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId   String?
  createdAt DateTime  @default(now())

  comments  Comment[]
  likes     Like[]
}

model Comment {
  id        String    @id @default(cuid())
  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String
  author    User      @relation(fields: [authorId], references: [id])
  authorId  String
  content   String
  parent    Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  parentId  String?
  replies   Comment[] @relation("CommentReplies")
  createdAt DateTime  @default(now())
}

enum ReactionType {
  LIKE
  LOVE
  FIRE
  LAUGH
  WOW
}

model Like {
  id        String       @id @default(cuid())
  post      Post         @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String
  user      User         @relation(fields: [userId], references: [id])
  userId    String
  type      ReactionType @default(LIKE)
  createdAt DateTime     @default(now())

  @@unique([postId, userId])
}

model Story {
  id        String   @id @default(cuid())
  author    User     @relation(fields: [authorId], references: [id])
  authorId  String
  imageUrl  String
  caption   String?
  createdAt DateTime @default(now())
  expiresAt DateTime
}

enum GroupRole {
  OWNER
  ADMIN
  MEMBER
}

model Group {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  avatarUrl   String?
  coverUrl    String?
  owner       User     @relation("GroupOwner", fields: [ownerId], references: [id])
  ownerId     String
  createdAt   DateTime @default(now())

  members GroupMember[]
  posts   Post[]
}

model GroupMember {
  id       String    @id @default(cuid())
  group    Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId  String
  user     User      @relation(fields: [userId], references: [id])
  userId   String
  role     GroupRole @default(MEMBER)
  joinedAt DateTime  @default(now())

  @@unique([groupId, userId])
}

model Achievement {
  id          String @id @default(cuid())
  key         String @unique
  name        String
  description String
  icon        String

  users UserAchievement[]
}

model UserAchievement {
  id            String      @id @default(cuid())
  user          User        @relation(fields: [userId], references: [id])
  userId        String
  achievement   Achievement @relation(fields: [achievementId], references: [id])
  achievementId String
  unlockedAt    DateTime    @default(now())

  @@unique([userId, achievementId])
}

enum NotificationType {
  FOLLOW
  LIKE
  COMMENT
  MATCH_INVITE
  MATCH_RESULT
  MESSAGE
  ACHIEVEMENT
}

model Notification {
  id        String           @id @default(cuid())
  target    User             @relation("NotificationTarget", fields: [targetId], references: [id])
  targetId  String
  type      NotificationType
  message   String
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())
}

model Conversation {
  id              String   @id @default(cuid())
  participantA    User     @relation("ParticipantA", fields: [participantAId], references: [id])
  participantAId  String
  participantB    User     @relation("ParticipantB", fields: [participantBId], references: [id])
  participantBId  String
  createdAt       DateTime @default(now())

  messages Message[]

  @@unique([participantAId, participantBId])
}

model Message {
  id             String       @id @default(cuid())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String
  sender         User         @relation("MessageSender", fields: [senderId], references: [id])
  senderId       String
  content        String
  readAt         DateTime?
  createdAt      DateTime     @default(now())
}
